{
  "name": "automation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build:web": "pnpm --filter @automation/web build",
    "dev": "pnpm --filter @automation/web dev",
    "dev:full": "node ./scripts/dev-full.mjs",
    "dev:host": "node ./scripts/dev-host.mjs",
    "dev:host:next": "node ./scripts/dev-host.mjs --next",
    "dev:server": "node ./scripts/dev-server.mjs",
    "dev:static": "pnpm --filter @automation/web build -- --watch",
    "dev:tutti": "node ./scripts/dev-tutti.mjs start",
    "dev:tutti:reload": "node ./scripts/dev-tutti.mjs reload",
    "dev:tutti:serve": "node ./scripts/dev-tutti.mjs serve",
    "dev:tutti:status": "node ./scripts/dev-tutti.mjs status",
    "dev:tutti:stop": "node ./scripts/dev-tutti.mjs stop",
    "package:tutti-app": "node ./scripts/package-tutti-app.mjs",
    "package:tutti-app:next": "node ./scripts/package-tutti-app.mjs --next",
    "test:server": "python3 -m unittest server_test.py",
    "typecheck": "pnpm --filter @automation/web typecheck"
  }
}
